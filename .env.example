# ==============================================================================
# Email Dispatcher Monorepo - Generic Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR LOCAL VALUES
# DO NOT COMMIT ACTUAL .env FILES OR SECRETS TO GIT
# ==============================================================================

# Server Configuration
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=email_dispatcher
DB_SSL_MODE=disable

# Redis Configuration (Asynq Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP Server Configuration (Default to local Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Campaign Dispatcher"

# Next.js Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
