# Stage 1: Build binary
FROM golang:1.23-alpine AS builder

WORKDIR /app

# Copy workspace configuration and module definitions
COPY go.work go.work.sum ./
COPY backend/db/go.mod backend/db/go.sum ./backend/db/
COPY backend/engine/go.mod backend/engine/go.sum ./backend/engine/
COPY backend/api/go.mod backend/api/go.sum ./backend/api/

# Download dependencies
RUN cd backend/api && go mod download

# Copy source code
COPY backend/db ./backend/db
COPY backend/engine ./backend/engine
COPY backend/api ./backend/api

# Build static API binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/api ./backend/api

# Stage 2: Minimal runtime image (<30MB)
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /bin/api /app/api

EXPOSE 8080

CMD ["/app/api"]
